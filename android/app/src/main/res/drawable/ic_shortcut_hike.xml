<?xml version="1.0" encoding="utf-8"?>
<!-- ★2026-10-19 桌面快捷方式专用图标「一个人爬山」（用户要求：原来复用启动图标，现改为爬山人形矢量图）
     设计：
       · 左侧 —— 实心人形：头 + 前倾躯干 + 双腿 + 前伸手臂 + 一根登山杖，脚下踩一段斜坡线；
       · 右侧 —— 一座实心三角形山；
       · 实心体 + 细线条混合，保证在快捷方式实际尺寸（32~48dp）下仍能看出「人往山上走」。
     ★配色用深灰蓝 #1E293B（与 App 文字色同族）：快捷方式图标由系统放在浅色/中灰圆角底上，
       深色剪影对比最稳；纯白在浅底上会看不见。
     ★本文件只在 shortcuts.xml 里被引用，不影响启动图标。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 脚下斜坡 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E293B"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M1.5,21.5 L9.2,13.2" />

    <!-- 右侧山 -->
    <path
        android:fillColor="#1E293B"
        android:pathData="M12,21 L17.2,9.6 L22.5,21 Z" />

    <!-- 头 -->
    <path
        android:fillColor="#1E293B"
        android:pathData="M5.5,7.2 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />

    <!-- 躯干（略前倾） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E293B"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M7.9,9.4 L5.9,14.8" />

    <!-- 后腿（蹬地） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E293B"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M5.9,14.8 L4.3,18.6" />

    <!-- 前腿（抬起迈步） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E293B"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M5.9,14.8 L7.9,17.8" />

    <!-- 手臂 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E293B"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M7.7,10.4 L10,12.2" />

    <!-- 登山杖 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E293B"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M10,9.4 L10.9,18.8" />
</vector>
