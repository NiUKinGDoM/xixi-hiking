<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- ★2026-08-27 渐进增强：浅色模式底部导航栏白色 + 深色图标（深色模式在 values-night 覆盖） -->
        <item name="android:navigationBarColor">#ffffff</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- ★2026-08-27 防闪白：window 背景 = App 浅色背景（splash 关闭后、WebView 内容渲染前不再露白） -->
        <item name="android:windowBackground">#ffffff</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ 强制系统 splash：背景设为 App 内容同色（视觉无缝），图标透明，立即关闭（★2026-08-27 用户否决 logo 方案，恢复透明） -->
        <item name="windowSplashScreenBackground">@color/app_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/app_bg_light</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>